<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="circle_track_world">
    <gravity>0 0 -9.8</gravity>

    <!-- Nguồn sáng mặt trời tiêu chuẩn Gazebo -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Mặt sân phẳng hiển thị đường đua hình tròn 10m nền đen -->
    <model name='circle_track_plane'>
      <static>1</static>
      <pose>0 0 0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>14.0 14.0</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <collide_bitmask>65535</collide_bitmask>
            </contact>
          </surface>
        </collision>

        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>14.0 14.0</size>
            </plane>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 0</specular>
            <emissive>0 0 0 1</emissive>
            <script>
              <uri>model://circle_track_10m/materials/scripts</uri>
              <uri>model://circle_track_10m/materials/textures</uri>
              <name>CircleTrack/Image</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cấu hình vật lý chuẩn BFMC -->
    <physics name='default_physics' default='0' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
    </scene>
  </world>
</sdf>
